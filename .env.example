# Sable local environment.
#
#   cp .env.example .env      (then fill in the values below)
#
# `.env` is gitignored; this template is not. Never put a real key in here.
#
# Both playground launchers read `.env` from the repo root and forward these
# into the container. A variable already set in your shell wins, so you can
# override any of these for one run without editing the file.

# ── backend ────────────────────────────────────────────────────────────────
# Which provider to use: ollama | openai | anthropic
SABLE_BACKEND=openai

# The model. Cost tracking only recognises models listed in
# sable/llm/pricing.json; anything else still works but reports $0.00 in
# /stats and the sidebar.
#   openai:    gpt-4o-mini (cheap, the wizard's default) | gpt-4o
#   anthropic: claude-sonnet-5 | claude-haiku-4-5
#   ollama:    llama3.1
SABLE_MODEL=gpt-4o-mini

# ── credentials ────────────────────────────────────────────────────────────
# Only the one matching SABLE_BACKEND is needed. Leave the rest blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── ollama only ────────────────────────────────────────────────────────────
# Where the Ollama server lives. From inside the playground container, the
# host is reachable as host.docker.internal, not localhost.
# SABLE_API_BASE=http://host.docker.internal:11434

# ── optional ───────────────────────────────────────────────────────────────
# Run the whole shell against canned responses: no API calls, no key needed.
# Useful for demos and for exercising the agent loop for free.
# SABLE_MOCK_LLM=1
